#FOR COMPOSE

# Use 'openssl rand -hex 32' to generate a strong key
SECRET_KEY=django-insecure-your-secret-key-here

# Comma-separated list of hosts (e.g., 127.0.0.1,example.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

DEBUG=False


# --- DATABASE SETTINGS ---
# Information:
#  Keep in mind that the values ​​for DB_NAME, DB_USER, and DB_PASS
#  are the ones PostgreSQL will use when creating the image;
#  so, if you want a different database name, password, or username
#  you should change them in the fields below.

DB_NAME=voting_db
DB_USER=voting_user
DB_PASS=voting_password
DB_HOST=db # db is the service name in compose.yml, rename it if you change the service name
DB_PORT=5432


# --- RECAPTCHA SETTINGS ---
# VERY IMPORTANT!
# For local development and testing, you can use Google's official test keys
# Note: Test keys will always pass validation without a challenge
RECAPTCHA_PUBLIC_KEY=your_public_key
RECAPTCHA_PRIVATE_KEY=your_private_key


# --- EMAIL SETTINGS ---
# VERY IMPORTANT!
# This email is mandatory for user registration
# It will be used strictly for account verification and critical system alerts
EMAIL_NAME=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password
